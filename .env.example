# 本地框架验证。启动命令会读取项目根目录的 .env。
CNLC_DATA_DIR=var
CNLC_BUS_MODE=simulated
CNLC_DEFAULT_USER_ID=local-demo
# OpenAI-compatible chat provider. The API key stays in .env and is not
# copied into the AgentScope credential database.
MODEL_BASE_URL=https://api.example.com/v1
MODEL_NAME=your-model-name
MODEL_API_KEY=replace-me
# Optional context/output sizes used when AgentScope has no model card.
# MODEL_CONTEXT_SIZE=128000
# MODEL_OUTPUT_SIZE=8192
# 连接测试 Redis 时，将 CNLC_BUS_MODE 设置为 redis。
# CNLC_REDIS_URL=redis://127.0.0.1:6379/0
